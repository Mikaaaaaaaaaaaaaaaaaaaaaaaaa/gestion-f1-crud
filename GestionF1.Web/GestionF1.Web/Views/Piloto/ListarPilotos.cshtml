@model List<GestionF1.Web.EF.Piloto>

<style>
    body {
        color: black;
        font-family: 'Montserrat';
    }

    select {
    padding: 3px 15px 3px 0px;
    border: 2px solid black;
    border-radius: 5px;
    }

    label {
        margin-right: 7px;
    }

    form {
        display: flex;
        gap: 15px;
        align-items: flex-start;
        flex-direction: column;
    }

    button {
        border: 2px solid black;
        background-color: yellow;
        border-radius: 5px;
        box-shadow: 3px 3px 0px 0px #00000057;
    }

    select#idEscuderia {
        border: 2px solid black;
        border-radius: 5px;
    }

    table {
        color: black;
        border-collapse: collapse;
        margin-top: 20px;
    }

    th, td {
        border: 1px solid black;
        padding: 8px;
    }

    table {
    border-radius: 5px;
    box-shadow: 0px 0px 0px 1px black;
    text-align: center;
    }

    #id_button_eliminar {
    border: 2px solid black;
    background-color: red;
    border-radius: 5px;
    box-shadow: 3px 3px 0px 0px #00000057;
    margin: auto;
    }
</style>

<h2>LISTADO DE PILOTOS</h2>

<form asp-action="ListarPilotos" method="get">
    <select name="idEscuderia" asp-items="ViewBag.Escuderias">
        <option value="">TODAS LAS ESCUDERÍAS</option>
    </select>

    <button type="submit">FILTRAR</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Escudería</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var piloto in Model)
        {
            <tr>
                <td>@piloto.NombrePiloto</td>
                <td>@piloto.IdEscuderiaNavigation?.NombreEscuderia</td>
                <td>
                    <form asp-action="EliminarPiloto" method="post">
                        <input type="hidden" name="id" value="@piloto.IdPiloto" />
                        
                        <button type="submit" id="id_button_eliminar">ELIMINAR</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>